# Hugging Face token for PyAnnote speaker diarization
HF_TOKEN=hf_your_token_here

# Database URL (default: SQLite)
DATABASE_URL=sqlite+aiosqlite:///./data/transcribe.db

# Upload directory
UPLOAD_DIR=./uploads

# Whisper model size: tiny, base, small, medium, large-v2, large-v3
WHISPER_MODEL=base

# Device: cpu, cuda, auto
DEVICE=auto

# Max upload size in bytes (default: 500MB)
MAX_UPLOAD_SIZE=524288000
