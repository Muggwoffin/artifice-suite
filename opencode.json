{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": {
      "*": "ask",
      "/tmp/**": "allow",
      "~/.ssh/**": "deny",
      "~/.gnupg/**": "deny",
      "~/.aws/**": "deny",
      "~/.callosip/**": "deny",
      "~/.config/opencode/**": "deny",
      "~/.local/share/opencode/auth.json": "deny"
    }
  }
}
