{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": {
      "*": "ask",
      "/tmp/**": "allow",
      "~/.local/share/artifice-transcribe/**": "allow",
      "~/.local/share/artifice-ocr/**": "allow",
      "~/.local/share/artifice-draft/**": "allow",
      "~/.local/share/artifice-graph/**": "allow",
      "~/.config/artifice-*/**": "allow",
      "~/.ssh/**": "deny",
      "~/.gnupg/**": "deny",
      "~/.aws/**": "deny",
      "~/.callosip/**": "deny",
      "~/.config/opencode/**": "deny",
      "~/.local/share/opencode/auth.json": "deny"
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local, host GPU)",
      "options": {
        "baseURL": "http://172.21.176.1:11434/v1"
      },
      "models": {
        "qwen2.5-coder-14b-16k:latest": {
          "name": "Qwen2.5-Coder 14B (local, 16k ctx)",
          "limit": {
            "context": 16384,
            "output": 8192
          }
        },
        "qwen2.5-coder:32b": {
          "name": "Qwen2.5-Coder 32B (local, does NOT fit 16GB VRAM)",
          "limit": {
            "context": 16384,
            "output": 8192
          }
        },
        "gemma4-32k:12b": {
          "name": "Gemma 4 12B (32k ctx, local)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    }
  },
  "mcp": {
    "firecrawl": {
      "type": "local",
      "command": ["npx", "-y", "firecrawl-mcp"],
      "environment": {
        "FIRECRAWL_API_URL": "http://localhost:3002",
        "FIRECRAWL_API_KEY": "local"
      },
      "timeout": 60000,
      "enabled": true
    }
  },
  "agent": {
    "lead-engineer": {
      "permission": {
        "firecrawl_*": "allow"
      }
    },
    "tester": {
      "permission": {
        "firecrawl_*": "allow"
      }
    },
    "arch-auditor-docs": {
      "permission": {
        "firecrawl_*": "deny"
      }
    },
    "security-auditor": {
      "permission": {
        "firecrawl_*": "deny"
      }
    },
    "oss-reviewer": {
      "permission": {
        "firecrawl_*": "deny"
      }
    },
    "code-reviewer": {
      "permission": {
        "firecrawl_*": "deny"
      }
    },
    "ui-ux": {
      "permission": {
        "firecrawl_*": "deny"
      }
    }
  }
}
